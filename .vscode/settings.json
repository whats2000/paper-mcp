{
  // Point the editor at this project's own virtualenv.
  //
  // Without this, VS Code falls back to the user-level
  // `python.defaultInterpreterPath`. When that points at a bare uv-managed
  // Python install (a directory with no pyvenv.cfg, not a virtualenv), the
  // Python extension still exports it as VIRTUAL_ENV into terminals and
  // extension-spawned processes. uv then rejects it on every command:
  //
  //   warning: `VIRTUAL_ENV=...` does not match the project environment
  //   path `.venv` and will be ignored
  //
  // and Pylance reports this project's dependencies as "not installed",
  // because it is resolving against an interpreter that does not have them.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.typeCheckingMode": "strict"
}
